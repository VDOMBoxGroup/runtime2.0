		'sfd_items_selected': sel || []
	}).find('.items').html('');
	$j('.sf-disabled',sf).css({
		opacity: 0.7,
		width: '100%%',
		height: '100%%'
	});
	*/
	vdom_sfd_set_handlers(sf);
}

