function vdom_sfd_selected_add(sfid, guid){
	var sa = sfid.data('sfd_items_selected');
	var x = $j.inArray(guid, sa);
	if (x < 0) {
		sa.push(guid);
		sfid.data('sfd_items_selected', sa);
	}
}

function vdom_sfd_selected_remove(sfid, guid){
	var sa = sfid.data('sfd_items_selected');
	var x = $j.inArray(guid, sa);
	if (x >= 0) {
		sa.splice(x,1);
		sfid.data('sfd_items_selected', sa);
	}
}

function vdom_sfd_refresh(sf){
	$j('.info .btn-add, .info .btn-edit',sf).show(0);
	$j('.info .btn-save, .info .btn-cancel',sf).hide(0);
	//execEventBinded('%(woid)s', "requestmeta", {});
	var ddr = sf.data('sfd');
	if (typeof ddr === 'array' || typeof ddr === 'object') {
		var dr = $j('<div></div>');
		if (ddr['data'] !== 'undefined')
		$j.each(ddr['data'], function(i,e){
			var a = {
				type:     e['type'] || 'string',
				name:     e['name'] || '',
				title:    e['title'] || '',
				value:    e['value'] || '',
				editable: !!e['editable']
			};
			var at = a['type'], inp = '', aq = a['value'].replace("'",'&prime;');
			if (at == 'date') {
				inp = "<label>"+a['title']+"<span title='"+aq+"'>"+a['value']+"</span></label>";
			} else
			if (at == 'link') {
				inp = "<label>"+a['title']+"<span title=''><a href='"+a['value']+"'>"+a['valuetitle']+"</a></span></label>";
/*			} else
			if (at == 'smartfolderlink') {
				inp = "<label>"+a['title']+"<span>"+a['value']+"</span></label>";
			} else
			if (at == 'contactlink') {
*/
			} else { // string
				inp = "<label>"+a['title']+"<span title='"+aq+"'>"+a['value']+"</span></label>";
			}
			var s = $j('<div class="meta type-'+a['type']+'">'+inp+'<div class="clear"></div></div>');
			s.appendTo(dr);
		});
	}
	$j('.metafields',sf).html('').append($j('>div',dr)).append('<div class="clear"></div>');
}

function vdom_sfd_disable(id){
	$j('#'+id+' .sf-disabled').fadeIn('fast');
}

function vdom_sfd_enable(id){
	$j('#'+id+' .sf-disabled').fadeOut('fast');
}

function vdom_sfd_load(id, data){
	var sf = $j('#'+id);
	var dd = data || '';
	if (dd == '') {
		dd = sf.data('sfd');
	} else {
		dd = data;
	}
	sf.data('sfd', dd);
	vdom_sfd_refresh(sf);
	$j('.title',sf).text(dd['title'] || '');
/*
	// pages
	d = [];
	var ii, tot = parseInt(total, 10), ipp = parseInt(sf.data('sfd_items_per_page'),10), curp = parseInt(sf.data('sf_current_page'),10);
	if (tot <= 0) tot = 1;
	if (ipp <= 0) ipp = 1;
	if (curp <= 0) curp = 1;
