		}
	}
	//$j('.pages',sf).html(d.join(' '));
*/
}

function vdom_sfd_set_handlers(sf){
	$j(".pages a",sf).on('click',function(){
		var page = 	parseInt($j(this).attr('rel'),10);
		if (page <= 0) page = 1;
		sf.data('sfd_current_page', page);
		var pa = sf.data('sfd_path');
		var p = (pa.length > 0) ? pa[pa.length-1] : '';
		execEventBinded(sf.data('sfd_woid'), "requestmeta", {"guid": p.guid, 'offset': sf.data('sfd_items_per_page')*(page-1), 'limit': sf.data('sfd_items_per_page') }, true);
		return false;
	});
	$j(".info .btn-edit",sf).on('click',function(){
		dd = sf.data('sfd');
		if (typeof dd === 'array' || typeof dd === 'object') {
			var d = $j('<div></div>');
			if (dd['data'] !== 'undefined')
			$j.each(dd['data'], function(i,e){
				var a = {
					type:      e['type'] || 'string',
					name:      e['name'] || '',
					title:     e['title'] || '',
					value:     e['value'] || '',
					editable:  !!e['editable'],
					deletable: !!e['deletable']
				};
				var at = a['type'], inp = '', hdel = '', hedit = '';
				//if (at == 'date') {
				//	inp = "<label>"+a['title']+"<input type='text' name='"+a['name']+"' value='"+a['value']+"' /></label>";
				/*} else
				if (at == 'list') {
					inp = "<label>"+a['title']+"<input type='text' name='"+a['name']+"' /></label>";
				} else
				if (at == 'smartfolderlink') {

				} else
				if (at == 'contactlink') {
*/
				//} else { // string
					//inp = "<label><a href='#' class='del'></a> "+a['title']+"<input type='text' name='"+a['name']+"' value='"+a['value']+"' /></label>";
					if (a['deletable']) hdel = "<a href='#' class='del'></a> ";
					if (!a['editable']) hedit = " disabled readonly ";
					inp = "<label>"+hdel+a['title']+"<input type='text' name='"+a['name']+"' value='"+a['value']+"'"+hedit+" /></label>";
				//}
				var s = $j('<div class="meta type-'+a['type']+'">'+inp+'<div class="clear"></div></div>');
				s.appendTo(d);
			});
		}
		$j('.metafields',sf).html('').append($j('>div',d)).append('<div class="clear"></div>');
		$j('.info .btn-add, .info .btn-edit',sf).hide(0);
		$j('.info .btn-save, .info .btn-cancel',sf).show(0);
	});
	$j(".info .metafields .meta a.del",sf).on('click',function(){
		$j(this).parent().remove();
		// todo: remove from data[]
		return false;
	});
	$j(".info .btn-add",sf).on('click',function(){
		execEventBinded(sf.data('sfd_woid'), "addmeta", {});
		return false;
	});
	$j(".info .btn-save",sf).on('click',function(){
		//$j('.sf-disabled',sf).fadeIn('fast');
		execEventBinded(sf.data('sfd_woid'), "editmeta", {data: $j('.metafields',sf).serializeArray()});
		return false;
	});
	$j(".info .btn-cancel",sf).on('click',function(){
		vdom_sfd_refresh(sf);
		return false;
	});
}

function vdom_sfd_init(woid,page,per,sel){
	var sf=$j('#o_'+woid);
	sf.data('sfd_woid', woid);
	/*
	sf.data({
		'sfd_selectmode': 0,
