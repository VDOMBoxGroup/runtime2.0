		<Attribute>
			<Name>timelineconfig</Name>
			<DisplayName>#Lang(033)</DisplayName>
			<Description>#Lang(032)</Description>
			<DefaultValue>//===============
          //Timeline configuration
          //===============
          scheduler.createTimelineView({
            name: &quot;timeline&quot;,
            x_unit: &quot;day&quot;,
            x_date: &quot;%j&quot;,
            x_step: 1,
            x_size: 31,
            section_autoheight: false,
            y_unit: scheduler.serverList(&quot;redactors&quot;),
            y_property: &quot;redactor&quot;,
            render: &quot;bar&quot;,
            round_position: true,
            event_dy: &quot;full&quot;,
            dy: 60,
            dx: 400,
            second_scale: {
              x_unit: &quot;month&quot;,
              x_date: &quot;%F, %Y&quot;,
            },
          });

          // Header labels config
          var headerHTML =
            &quot;&lt;div class=&apos;timeline_item_cell&apos;&gt;Redacteur&lt;/div&gt;&quot; +
            &quot;&lt;div class=&apos;timeline_item_cell&apos;&gt;Fin de la redaction&lt;/div&gt;&quot;;
          scheduler.locale.labels.timeline_scale_header = headerHTML;

          scheduler.templates.timeline_scale_label = function (key, label, section) {
            const imgSrc = &quot;https://www.svgrepo.com/show/57853/avatar.svg&quot;;
            return [
              &quot;&lt;div class=&apos;timeline_item_cell&apos;&gt;&quot; +
                `&lt;img class=&apos;redactor-image&apos; src=&apos;${imgSrc}&apos;/&gt;` +
                `&lt;div class=&apos;redactor-info-wrapper&apos;&gt;` +
                `&lt;span class=&apos;redactor-name&apos;&gt;${section.label}&lt;/span&gt;` +
                `&lt;span&gt;${section.number}&lt;/span&gt;` +
                `&lt;span&gt;${section.description} / ${section.employment_type}&lt;/span&gt;` +
                `&lt;/div&gt;` +
                &quot;&lt;/div&gt;&quot;,
              &quot;&lt;div class=&apos;timeline_item_cell room_status&apos;&gt;&quot;,
              &quot;&lt;span class=&apos;status-label&apos;&gt;&quot; +
                scheduler.getRedactorByKey(key).end_time +
                &quot;&lt;/span&gt;&quot;,
              &quot;&lt;/div&gt;&quot;,
            ].join(&quot;&quot;);
          };</DefaultValue>
			<RegularExpressionValidation>.*</RegularExpressionValidation>
			<ErrorValidationMessage>#Lang(004)</ErrorValidationMessage>
			<Visible>1</Visible>
			<InterfaceType>0</InterfaceType>
			<CodeInterface>MultiLine()</CodeInterface>
			<ColorGroup>4</ColorGroup>
