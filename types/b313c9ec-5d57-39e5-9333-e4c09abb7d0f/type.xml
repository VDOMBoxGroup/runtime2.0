function vdom_sf_set_dnd(sfid, sfwoid, sfclass) {
	$j("#"+sfid+" .items ."+sfclass).draggable({
		containment: 'document',
		revert: 'invalid',
		revertDuration: 200,
		zIndex: 99999,
		opacity: 0.6,
		helper: 'original',
		cursor: 'default',
		start: function(e,u){
			//var x = $j('#%(id)s').data("sf"), i = $j(this).attr('index');
			//execEventBinded('%(woid)s', "dragstart", {item: x[i]}, true);
			var x = $j(this).data("sf");
			execEventBinded(sfwoid, "dragstart", {item: x['guid']}, true);
		}
	});
	$j("#"+sfid+" .items ."+sfclass).droppable({
		accept: "."+sfclass,
		hoverClass: sfclass+"-hover",
		drop: function(e,u) {
			$j(u.draggable).fadeOut(100);
			//var x = $j('#%(id)s').data("sf"), i1 = $j(u.draggable).attr('index'), i2 = $j(this).attr('index');
			//execEventBinded('%(woid)s', "drop", {"itemsource": x[i1], "itemtarget": x[i2]}, true);
			var x1 = $j(u.draggable).data("sf"), x2 = $j(this).data("sf");
			$j("#"+sfid+' .item-panel').removeClass('group folder');
			$j("#"+sfid).removeClass('has-current');
			$j("#"+sfid+' .items .current').removeClass('current');
			vdom_sf_selected_remove_all($j("#"+sfid));
			execEventBinded(sfwoid, "drop", {"itemsource": x1['guid'], "itemtarget": x2['guid']}, true);
		}
	});
}

