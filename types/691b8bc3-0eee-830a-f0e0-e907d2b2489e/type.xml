		<Actions>
			<Container ID="2330fe83-8cd6-4ed5-907d-11874e7ebcf4">
				<Action Name="activateTab" DisplayName="#Lang(601)" Description="#Lang(501)">
					<Parameters>
						<Parameter Name="openTab" DisplayName="#Lang(701)" Description="#Lang(801)" DefaultValue="" RegularExpressionValidation=".*" Interface="" />
					</Parameters>
					<SourceCode>
<![CDATA[var id = this.domCont.id;		  
eval('var x=tabview_children_'+id+';');
if (typeof x !== 'undefined') {
	$q('#'+id+' div.content_'+id+'>div').hide();
	$q.each(x, function(i, el) {
		var tab = $q('#ul_'+id+' a[href="#'+el[3]+'"]')
			if (openTab == el[0] || openTab == el[1] || openTab == el[2]) {
				$q('#'+el[3]).show();
				if (tab){ tab.addClass('active'); }
				execEventBinded(id.substring(2, id.length), "tabchanged", {ID:el[0], Name:el[1], hierarchy:el[2]});		
			} else {
				$q('#'+el[3]).hide();
				if (tab){ tab.removeClass('active'); }
			}
   
	});
}]]>
					</SourceCode>
				</Action>
				<Action Name="addClass" DisplayName="#Lang(603)" Description="#Lang(513)">
					<Parameters>
						<Parameter Name="className" DisplayName="#Lang(803)" Description="#Lang(703)" DefaultValue="" RegularExpressionValidation="" Interface="" />
