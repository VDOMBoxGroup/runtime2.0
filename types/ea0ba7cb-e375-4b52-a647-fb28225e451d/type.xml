							{ unit: &quot;month&quot;, format: &quot;%M %Y&quot;, step: 1, css: () =&gt; &apos;&apos; },
							{
								unit: &quot;week&quot;, step: 1, format: function (date) {
									const dateToStr = gantt.date.date_to_str(&quot;%d %M&quot;);
									const endDate = gantt.date.add(date, -6, &quot;day&quot;);
									return dateToStr(date) + &quot; - &quot; + dateToStr(endDate);
								}
							}
						],
