					<SourceCode>
<![CDATA[var t = $(this.domCont), id = this.domCont.id;
var only1 = false;
if (!t.hasClass('multiselect')){
  t.find('li[itemid].selected').removeClass("selected");
  only1 = true;
}

for (var i of items){
  l = t.find('li[itemid="'+i+'"]');
  if (!l.hasClass('selected')){
    l.addClass('selected');
  }
  if (only1) break;
}

var a = [];
var k = t.find('li.selected[itemid]');
k.each(function(i,e){ a.push($q(e).attr('itemid')); });
execEventBinded(id.substring(2, id.length), "rowsselected", {keyList:a});]]>
